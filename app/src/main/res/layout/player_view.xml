<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView inflated from XML rather than built in code, for one reason:
  `controller_layout_id` is a styleable, not a setter, so this is the only way to
  hand Media3 the controller layout in `player_controller.xml`. See that file for
  what it changes and why.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:controller_layout_id="@layout/player_controller" />
