<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols Outlined "tune", Apache-2.0.

  Filled white, not tinted, because the reader is Media3's own `ImageButton`
  rather than Compose's `Icon`. Media3's controller buttons carry no
  `android:tint` at all — you can see that in `ExoStyledControls.Button`, which
  sets only a background, a scale type and margins — so each icon is responsible
  for its own colour, and a black one is invisible on the controller's dark
  scrim. Every `exo_styled_controls_*` drawable is `#FFFFFFFF` for this reason.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <!-- The source viewBox starts at y = -960; shift it into the viewport. -->
    <group android:translateY="960">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M440-120v-240h80v80h320v80H520v80h-80Zm-320-80v-80h240v80H120Zm160-160v-80H120v-80h160v-80h80v240h-80Zm160-80v-80h400v80H440Zm160-160v-240h80v80h160v80H680v80h-80Zm-480-80v-80h400v80H120Z" />
    </group>
</vector>
