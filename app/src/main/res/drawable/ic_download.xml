<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols Outlined "download", Apache-2.0.
  Source: https://raw.githubusercontent.com/google/material-design-icons/master/symbols/web/download/materialsymbolsoutlined/download_24px.svg

  Path data is byte-for-byte the upstream `d` attribute. The source viewBox is
  already "0 -960 960 960" — the same 960 grid this drawable uses — so there is
  no rescaling here (nothing x40 or otherwise): the glyph is moved into the
  viewport with a single translateY, exactly as `ic_brightness.xml` does.

  Filled white, not tinted, for the reason spelled out in
  `ic_orientation_landscape.xml`: these icons are read by views that set no
  `android:tint`, so each icon carries its own colour, and anything but white
  would disappear against the dark background the shortcut list is drawn on.

  Shown as the leading mark of the "下载" (Downloads) shortcut row in the
  quick-directory list on the Local Files tab; tapping the row jumps the file
  browser to the Downloads directory. An arrow dropping onto a tray is the
  conventional "download" mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <!-- The source viewBox starts at y = -960; shift it into the viewport. -->
    <group android:translateY="960">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z" />
    </group>
</vector>
