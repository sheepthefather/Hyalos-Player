<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols Outlined "stay_current_portrait", Apache-2.0.

  Filled white for the reason given in `ic_orientation_landscape.xml`. Shown when
  the picture is landscape, i.e. it names where the button will take you.

  A note for anyone who tries to save a file here by rotating the other one: the
  two glyphs are near enough the same shape that rotating looks right, but they
  are not the same drawing — this one's screen sits lower (200 units of bezel
  above, 40 below, against 160 and 120 when turned). If you do rotate, remember
  that a group's pivot is read in the coordinates of *that* group's own layer:
  put the rotation outside `translateY(960)` and pivot on (480, 480), or the shape
  turns about a point a whole viewport away and the drawable comes out empty.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <!-- The source viewBox starts at y = -960; shift it into the viewport. -->
    <group android:translateY="960">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M280-40q-33 0-56.5-23.5T200-120v-720q0-33 23.5-56.5T280-920h400q33 0 56.5 23.5T760-840v720q0 33-23.5 56.5T680-40H280Zm0-120v40h400v-40H280Zm0-80h400v-480H280v480Zm0-560h400v-40H280v40Zm0 0v-40 40Zm0 640v40-40Z" />
    </group>
</vector>
