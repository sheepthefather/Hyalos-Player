<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols Outlined "stay_current_portrait", Apache-2.0.

  The same path as `ic_orientation_landscape.xml`, turned a quarter turn: the
  two glyphs are one phone shape at two angles, so rotating is what the icon set
  does too, and it keeps the two files from drifting apart.

  The turn is the *outer* group, and the shift the inner one, which is not
  interchangeable: a pivot is read in the coordinates of the group it sits on. As
  written the pivot is the centre of the finished viewport, (480, 480). Nested the
  other way round the shape turns about a point a full viewport away from itself
  and leaves the drawable empty — which is how this file first shipped, and how
  the button came to have no icon at all.

  Filled white for the reason given in `ic_orientation_landscape.xml`. Shown when
  the picture is landscape, i.e. it names where the button will take you.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <group
        android:pivotX="480"
        android:pivotY="480"
        android:rotation="90">
        <!-- The source viewBox starts at y = -960; shift it into the viewport. -->
        <group android:translateY="960">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M120-200q-33 0-56.5-23.5T40-280v-400q0-33 23.5-56.5T120-760h720q33 0 56.5 23.5T920-680v400q0 33-23.5 56.5T840-200H120Zm40-80v-400h-40v400h40Zm80 0h480v-400H240v400Zm560 0h40v-400h-40v400ZM160-680h-40 40Zm640 0h40-40Z" />
        </group>
    </group>
</vector>
