<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols Outlined "stay_current_landscape", Apache-2.0.

  Filled white, not tinted, because the reader is Media3's own `ImageButton`
  rather than Compose's `Icon`. Media3's controller buttons carry no
  `android:tint` at all — `ExoStyledControls.Button` sets only a background, a
  scale type and margins — so each icon is responsible for its own colour, and a
  black one is invisible on the controller's dark scrim. Every
  `exo_styled_controls_*` drawable is `#FFFFFFFF` for this reason.

  Shown when the picture is portrait, i.e. it names where the button will take
  you rather than where you are.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <!-- The source viewBox starts at y = -960; shift it into the viewport. -->
    <group android:translateY="960">
        <path
            android:fillColor="#FFFFFFFF"
