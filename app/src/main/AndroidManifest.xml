<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      SMB is a network protocol, so the app is useless without this. While
      targetSdk is 36 it also implicitly covers local-network access. Raising
      targetSdk to 37 changes that: LAN access then needs the runtime
      ACCESS_LOCAL_NETWORK permission, and it applies to the Rust kernel's
      native sockets too. See ARCHITECTURE.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The local-files tab browses the device's own storage, and this is what lets
      it see past the app's sandbox to do so.

      A broad permission, granted deliberately: the app is a file browser for
      media the user already owns, and the alternatives do not reach far enough.
      Scoped storage's own picker (`ACTION_OPEN_DOCUMENT_TREE`) cannot select the
      root of shared storage or the Download folder — Android 11 made that
      impossible — so a folder-picking app could never show the whole device.
      Google Play restricts this permission to file managers; this app is
      distributed as an APK, so that does not apply.

      Not a runtime permission: there is no dialog for it. The user turns it on
      on a settings screen the app sends them to, which is why `LocalSource`
      checks rather than requests. See ARCHITECTURE.md.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      A copy between two sources is carried through this process, one chunk at a
      time, and can run for minutes. Without a foreground service the process is
      cached while it works and the system may reclaim it at any point — which
      does not merely fail the copy, it stops it half way with a partly-written
      file on the destination.

      `dataSync` is the type that describes this: moving the user's files. It has
      to be declared as well as the permission, and Android 14 requires the
      declaration to match the permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Needed from API 33 for the notification to be *seen*. The service runs
      either way, so a refusal costs the progress bar and the cancel button, not
      the protection.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HyalosApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyalosPlayer">

        <!--
          `configChanges` so that rotating the screen does not rebuild the
          activity. Two reasons, and the first one was a real bug:

          1. The player screen turns itself to landscape for widescreen video.
             Without this, that rotation counted as a configuration change, the
             activity was recreated, and the outgoing screen's `ON_STOP` paused
             the player — which lives in the ViewModel and survives recreation.
             The result was a video that opened, showed its first frame, and
             then sat still: playing for 24 milliseconds.
          2. Rebuilding tears down and reattaches the video surface, which shows
             as a black flash on every rotation.

          Compose handles these changes by recomposing — `LocalConfiguration` is
          updated and anything reading it redraws. Deliberately not listed:
          `locale`, `density` and `fontScale`, where recomposition alone would
          not be enough and a rebuild is the safer answer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Exists to hold the process up while a copy runs, and to be the place the
          progress bar lives. The work itself belongs to `CopyCoordinator`, which
          is process-wide: a service can be restarted and an activity can be
          destroyed, and neither should decide whether a copy continues.
        -->
        <service
            android:name=".files.CopyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
